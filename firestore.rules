rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function member() { return signedIn() && exists(/databases/$(db)/documents/profiles/$(request.auth.uid)); }

    // invite code lives here; clients can never read it, but rules can check it
    match /settings/{d} { allow read, write: if false; }

    match /profiles/{uid} {
      allow read: if member();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','code'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.code == get(/databases/$(db)/documents/settings/app).data.code;
    }
    match /wishes/{id} {
      allow read: if member();
      allow create, update: if member() && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 80;
      allow delete: if member() && resource.data.owner == request.auth.uid;
    }
    // public "taken" count only, no names. You can't mark your own item.
    match /taken/{id} {
      allow read: if member();
      allow write: if member() && exists(/databases/$(db)/documents/wishes/$(id))
        && get(/databases/$(db)/documents/wishes/$(id)).data.owner != request.auth.uid;
      allow delete: if member();
    }
    // private "to gift" list: only the person themselves
    match /users/{uid}/gifts/{id} {
      allow read, write: if member() && request.auth.uid == uid;
    }
  }
}
